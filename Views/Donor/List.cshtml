<a href="/donor/create">Add Donor</a>

@if (Model.Count != 0)
{
    <table > 
        <tr>
            <th>Full Name</th>
            <th>Blood Group</th>
            <th>Contact Number</th>
            <th>City</th>
            <th>Last Donation Date</th>
            <th>Actions</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.BloodGroup</td>
                <td>@item.ContactNo</td>
                <td>@item.City</td>
                <td>@item.LastDonationDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <a href="/Donor/Edit/@item.DonorId">Edit</a> 
                    |
                    <a href="/Donor/Delete/@item.DonorId">Delete</a>
                </td>
            </tr>
        }
    </table>
}
else
{
    <span>No donors found.</span>
}