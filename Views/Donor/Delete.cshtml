<h2>Delete Donor</h2>
<p>Are you sure you want to delete this donor?</p>

<div>
    <p><strong>Full Name:</strong> @Model.FullName</p>
    <p><strong>Blood Group:</strong> @Model.BloodGroup</p>
    <p><strong>Contact Number:</strong> @Model.ContactNo</p>
    <p><strong>City:</strong> @Model.City</p>
</div>

<form action="/Donor/Delete" method="post">
    <input type="hidden" name="DonorId" value="@Model.DonorId" />
    <input type="submit" value="Delete" style="color: red;" />
</form>

<br />
<a href="/Donor/List">Cancel and go back</a>